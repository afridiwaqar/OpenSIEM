# Add the services to OS

sudo cp opensiem-archive.service opensiem-archive.timer /etc/systemd/system/
sudo systemctl daemon-reload
sudo systemctl enable --now opensiem-archive.timer

# sanity check it's scheduled
systemctl list-timers opensiem-archive.timer

# test it manually right now, don't wait for 2:15am
sudo systemctl start opensiem-archive.service
journalctl -u opensiem-archive.service -n 30 --no-pager
