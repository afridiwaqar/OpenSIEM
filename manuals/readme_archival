
-- Install DuckDB for Archival feature

curl -L https://github.com/duckdb/duckdb/releases/latest/download/duckdb_cli-linux-amd64.zip \
  -o duckdb.zip && unzip duckdb.zip && sudo mv duckdb /usr/local/bin/
  
 
